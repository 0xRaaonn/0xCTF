# Infrastructure Data Security Configuration

# This directory contains sensitive infrastructure information

# Access is restricted to authorized personnel only

# Deny access to all files by default

<Files "\*">
Order allow,deny
Deny from all
</Files>

# Block directory listing

Options -Indexes

# Prevent access to sensitive file types

<FilesMatch "\.(xlsx|csv|txt|pdf|doc|docx)$">
Order allow,deny
Deny from all
</FilesMatch>

# Security headers

<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
    Header set X-Frame-Options DENY
    Header set X-XSS-Protection "1; mode=block"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Log all access attempts

<IfModule mod_log_config.c>
    LogFormat "%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\" [INFRASTRUCTURE_ACCESS]" infrastructure
    CustomLog /var/log/infrastructure_access.log infrastructure
</IfModule>

# Only allow specific IP ranges (if uncommented)

# <RequireAll>

# Require ip 192.168.1.0/24

# Require ip 10.0.0.0/8

# </RequireAll>
